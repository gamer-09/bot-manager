# ═══════════════════════════════════════════════════════════════════════════════
# Discord Bot Manager - Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Bot 1: Isekai Chronicles (just-bot) ────────────────────────────────────
BOT1_NAME=just-bot
BOT1_TOKEN=your_isekai_chronicles_bot_token_here
BOT1_PREFIX=!
BOT1_PORT=3000

# ─── Bot 2: Admin Help Bot ──────────────────────────────────────────────────
BOT2_NAME=admin-help-bot
BOT2_TOKEN=your_admin_help_bot_token_here
BOT2_GUILD_ID=your_discord_server_id_here
BOT2_WELCOME_CHANNEL=welcome
BOT2_PORT=3001

# ─── Bot 3: Tommyland (Falix Minecraft Manager) ────────────────────────────
BOT3_NAME=tommyland
BOT3_TOKEN=your_tommyland_bot_token_here
BOT3_PREFIX=!
BOT3_SERVER_SUBDOMAIN=your_server_subdomain
BOT3_MGMT_HOST=167.235.93.185
BOT3_MGMT_PORT=25580
BOT3_MGMT_SECRET=your_mgmt_secret_here
BOT3_OWNER_ID=your_owner_id_here
BOT3_GUILD_ID=your_guild_id_here
BOT3_PORT=3002

# ─── Bot 4: Discord Bot (Falix Minecraft Manager #2) ───────────────────────
BOT4_NAME=discord-bot
BOT4_TOKEN=your_discord_bot_token_here
BOT4_PREFIX=!
BOT4_SERVER_SUBDOMAIN=your_server_subdomain_2
BOT4_MGMT_HOST=167.235.93.185
BOT4_MGMT_PORT=25580
BOT4_MGMT_SECRET=your_mgmt_secret_here
BOT4_OWNER_ID=your_owner_id_here
BOT4_GUILD_ID=your_guild_id_here
BOT4_PORT=3003

# ─── Bot 5: Minecraft Status Bot ────────────────────────────────────────────
BOT5_NAME=mc-status
BOT5_TOKEN=your_minecraft_status_bot_token_here
BOT5_PREFIX=!
BOT5_SERVER_SUBDOMAIN=your_server_subdomain_3
BOT5_PORT=3004

# ─── Global Settings ────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Health check port (combined server)
HEALTH_PORT=8080
